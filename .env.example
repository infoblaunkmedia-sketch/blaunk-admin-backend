# Copy to .env and fill in values. Never commit .env.

# Public URL of the admin UI (CORS). On Render set this to your real frontend origin.
# Example: https://blaunk-admin-frontend.vercel.app
CLIENT_ORIGIN=http://localhost:5173

PORT=8000

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=2h

# MongoDB connection string (Atlas: include user, password, and DB name)
MONGO_URI=

ADMIN_USERNAME=Admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Optional: force IPv4 for mongodb+srv on some hosts (e.g. Render)
# MONGO_PREFER_IPV4=true
