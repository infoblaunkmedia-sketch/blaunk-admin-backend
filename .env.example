# Copy to .env and fill in values. Never commit .env.

# Public URL of the admin UI (CORS). On Render set this to your real frontend origin.
# Example: https://blaunk-admin-frontend.vercel.app
CLIENT_ORIGIN=http://localhost:5173

PORT=8000

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=2h

# Employee / 3P login: when IT has registered active MAC(s), device must match (default: true).
# Set false only for local dev without the MAC agent.
# MAC_LOGIN_ENFORCEMENT=true

# MongoDB connection string (Atlas: include user, password, and DB name)
MONGO_URI=

ADMIN_USERNAME=Admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Optional: force IPv4 for mongodb+srv on some hosts (e.g. Render)
# MONGO_PREFER_IPV4=true

# Cloudinary (Admin & Personnel → Media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PROJECT_FOLDER=bluank

# Optional SMTP for vendor approval/rejection emails (nodemailer)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
